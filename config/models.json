{
  "version": "2026.11",
  "updatedAt": "2026-11-06",
  "providerBridges": [
    {
      "id": "antigravity",
      "label": "Antigravity / Cloud Code Assist Bridge (Local OAuth)",
      "providers": ["antigravity"],
      "packageName": "pi-antigravity",
      "defaultInstallSpec": "git+https://github.com/Rahularya01/pi-antigravity.git",
      "envOverrideVar": "PI_BRIDGE_ANTIGRAVITY",
      "builtInAuthSupported": true,
      "directEnvVars": ["GEMINI_API_KEY", "ANTHROPIC_API_KEY"],
      "transportOnly": true,
      "allowGlobalFallback": true,
      "description": "Local desktop OAuth bridge for Antigravity endpoints; on cloud VMs/CI, GEMINI_API_KEY & ANTHROPIC_API_KEY run directly via built-in pi-ai without needing this extension."
    },
    {
      "id": "codex-bridge",
      "label": "OpenAI Codex Transport & ACP Native App",
      "providers": ["openai-codex", "codex", "openai"],
      "packageName": "pi-codex-bridge",
      "defaultInstallSpec": null,
      "envOverrideVar": "PI_BRIDGE_CODEX",
      "builtInAuthSupported": true,
      "directEnvVars": ["OPENAI_API_KEY", "CODEX_API_KEY"],
      "nativeAcpHarness": "codex-acp",
      "transportOnly": true,
      "allowGlobalFallback": true,
      "description": "Supports OPENAI_API_KEY / pi built-in Codex OAuth directly, or native OpenAI Codex CLI via --harness=codex-acp (@zed-industries/codex-acp)."
    },
    {
      "id": "claude-bridge",
      "label": "Claude Transport & ACP Native App",
      "providers": ["claude-bridge", "claude-code", "anthropic"],
      "packageName": "pi-claude-bridge",
      "defaultInstallSpec": null,
      "envOverrideVar": "PI_BRIDGE_CLAUDE",
      "builtInAuthSupported": true,
      "directEnvVars": ["ANTHROPIC_API_KEY", "CLAUDE_CODE_OAUTH_TOKEN"],
      "nativeAcpHarness": "claude-acp",
      "transportOnly": true,
      "allowGlobalFallback": true,
      "description": "Supports ANTHROPIC_API_KEY / Claude OAuth directly, or native Claude Code via --harness=claude-acp (@zed-industries/claude-code-acp)."
    },
    {
      "id": "muse",
      "label": "Meta Muse Direct API & Clean-Room Config",
      "providers": ["muse"],
      "packageName": "pi-muse",
      "defaultInstallSpec": null,
      "envOverrideVar": "PI_BRIDGE_MUSE",
      "builtInAuthSupported": true,
      "directEnvVars": ["MUSE_API_KEY", "OPENROUTER_API_KEY"],
      "transportOnly": true,
      "allowGlobalFallback": true,
      "description": "Native clean-room OpenAI-compatible Muse provider hydrated automatically from MUSE_API_KEY (https://api.meta.ai/v1) with OpenRouter fallback."
    }
  ],
