    {
      "id": "muse-msp",
      "label": "Muse CLI (MSP via pi)",
      "shortLabel": "muse-msp",
      "protocol": "pi-extension",
      "track": "vendor-harness",
      "vendor": "Meta",
      "agentProduct": "Muse CLI",
      "extensionPackage": "pi-muse-msp",
      "version": "0.2.7",
      "piProvider": "muse-msp",
      "requiresBinary": "muse",
      "binaryEnvVar": "PI_MUSE_BINARY",
      "provider": "muse",
      "compatibleFamilies": [
        "Muse (Meta)"
      ],
      "modelHints": [
        "muse"
      ],
      "defaultModelKey": "muse-spark",
      "supportsModes": [
        "agent"
      ],
      "description": "Runs Meta's Muse coding agent (`muse serve`, MSP stdio JSON-RPC) through the `pi-muse-msp` provider extension. The Muse host owns the system prompt, tools and approvals; pi is only the headless front end. Needs the `muse` CLI on PATH (or PI_MUSE_BINARY)."
    }
  ]
}
